{
  "name": "elemental-command",
  "version": "0.10.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "portable": "powershell -ExecutionPolicy Bypass -File ./tools/build-portable.ps1",
    "electron": "electron electron/main.cjs",
    "build:steam": "npm run build && electron-builder --config electron-builder.config.cjs",
    "dist:steam": "npm run build && electron-builder --config electron-builder.config.cjs --publish never",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts}": "echo 'lint ok'"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.3.1"
  }
}
