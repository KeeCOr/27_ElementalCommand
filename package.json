{
  "name": "elemental-command",
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "electron electron/main.cjs",
    "build:steam": "npm run build && electron-builder --config electron-builder.config.cjs",
    "dist:steam": "npm run build && electron-builder --config electron-builder.config.cjs --publish never"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.3.1"
  }
}
